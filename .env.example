# Скопируйте в .env.local, чтобы приложение работало через общий сервер (server/) —
# тогда оно видит те же данные, что и MCP-сервер. Без этой строки база локальная, на устройстве.
# Для телефона укажите адрес компьютера в Wi-Fi-сети, который печатает сервер при запуске.
EXPO_PUBLIC_API_URL=http://192.168.0.10:4000
